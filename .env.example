# ==========================================================
# BookMind AI — plantilla de configuración
# Copia este archivo a `.env` y rellena los valores.
# `.env` está en .gitignore y NUNCA debe commitearse.
#
# OBLIGATORIAS (el backend no arranca sin ellas, y dirá cuál falta):
#   ENV, PORT, API_URL, SWAGGER_USER, SWAGGER_PASS, JWT_SECRET,
#   JWT_ALGORITHM, JWT_EXPIRE, DB_*, MAX_FILE_SIZE_MB, FRONTEND_URL
# El resto tiene valores por defecto razonables.
#
# Generar un JWT_SECRET:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================================================

PORT = 3000
API_URL = http://localhost:3000/api
ENV = dev

# SWAGGER USER PASS
SWAGGER_USER =
SWAGGER_PASS =

# CONSTANTS
JWT_SECRET =
JWT_ALGORITHM = HS256
JWT_EXPIRE = 7d

# GOOGLE OAUTH
# Credenciales de tipo "Web application" en Google Cloud Console. El redirect URI
# debe estar autorizado ahí con exactamente el mismo valor.
GOOGLE_CLIENT_ID = <id>.apps.googleusercontent.com
GOOGLE_SECRET_ID = <secret>
GOOGLE_REDIRECT_URI = http://localhost:3000/api/auth/google/callback

# DATABASE
DB_HOST = localhost
DB_PORT = 5432
DB_USERNAME =
DB_PASSWORD =
DB_NAME =
DB_SCHEMA =

# ==========================================================
# Motor conversacional (pieza 1)
# Decisión aún abierta: gemini | ollama | mock
#   mock   -> respuestas simuladas, no requiere key ni GPU (por defecto en dev)
#   gemini -> requiere GEMINI_API_KEY de Google AI Studio
#   ollama -> requiere Ollama corriendo en local
# ==========================================================
LLM_PROVIDER = mock

# Opción A: Google Gemini — key gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY =
GEMINI_MODEL = gemini-3.6-flash
# Context caching abarata el libro completo en cada turno.
# Dejar en false hasta confirmar que el tier lo permite.
GEMINI_CONTEXT_CACHING = false

# Voz del chat (opcional): sin key, el botón de voz no funciona
ELEVENLABS_API_KEY =
ELEVENLABS_VOICE_ID = EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL = eleven_multilingual_v2

# Opción B: Ollama local
OLLAMA_BASE_URL = http://localhost:11434
OLLAMA_MODEL = llama3.1:8b
# Ollama no traga un libro completo (ventana ~128k). Con este flag el backend
# recupera solo los pasajes relevantes en vez de hacer Zero-RAG puro.
OLLAMA_USE_RETRIEVAL = true

# ==========================================================
# Pieza 2 — Verificador de anclaje (embeddings locales, sin API externa)
# ==========================================================
# Umbral medido: ancladas 0.92-0.93, inventadas 0.74-0.80. Ver README.
EMBEDDING_MODEL = Xenova/multilingual-e5-small
GROUNDING_THRESHOLD = 0.86

# ==========================================================
# Pieza 3 — Microservicio de clasificación (Python + FastAPI)
# ==========================================================
ML_SERVICE_URL = http://localhost:8000

# OCR de páginas escaneadas (lo ejecuta el ml-service con Tesseract; ver ml-service/README.md).
# OCR_DPI y OCR_WORKERS se configuran en el entorno del ml-service, que es quien rasteriza.
# false = un PDF escaneado solo se puede leer en el visor, sin chat ni Studio.
OCR_ENABLED = true
# Una página con menos caracteres nativos que esto se considera imagen y va a OCR.
OCR_MIN_CARACTERES = 50
# Debajo de esta confianza (0-1), la página no se usa para flashcards, quiz ni glosario.
OCR_CONFIANZA_MINIMA = 0.70
OCR_MAX_PAGINAS = 600

# Neon Object Storage (crea un bucket privado y una credencial con storage:read/write)
# neon env pull --file .env.local puede rellenar las cuatro variables AWS_* primeras.
AWS_ENDPOINT_URL_S3 =
AWS_REGION =
AWS_ACCESS_KEY_ID =
AWS_SECRET_ACCESS_KEY =
S3_BUCKET =
S3_FORCE_PATH_STYLE = true

MAX_FILE_SIZE_MB = 150

# Frontend (CORS)
FRONTEND_URL = http://localhost:4200
